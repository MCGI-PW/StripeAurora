{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },

  "Database": {
    "Provider": "MongoDB"
  },

  "MongoDb": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "aurora",
    "ServerSelectionTimeoutSeconds": 5,
    "SeedData": true
  },

  "ConnectionStrings": {
    "OracleConnection": ""
  },

  "Jwt": {
    "Issuer": "aurora-api",
    "Audience": "aurora-app",
    "Key": "",
    "ExpirationMinutes": 60
  },

  "Auth": {
    "AdminEmail": "admin@aurora.com",
    "AdminPassword": ""
  },

  "Stripe": {
    "SecretKey": "",
    "PublishableKey": "",
    "WebhookSecret": "",
    "Plans": {
      "Basic": "price_XXXXXXXXXXXX",
      "Premium": "price_YYYYYYYYYYYY"
    }
  },

  "AllowedHosts": "*"
}
